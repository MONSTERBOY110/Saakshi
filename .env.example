# Copy to .env.local (Next.js) and fill in. Never commit real values.

# AssemblyAI: one key for Streaming STT, Voice Agent API and LLM Gateway.
# Claim hackathon credits via the lablab page link before creating the key.
ASSEMBLYAI_API_KEY=

# LLM Gateway (OpenAI-compatible). US endpoint by default.
LLM_GATEWAY_BASE_URL=https://llm-gateway.assemblyai.com/v1
LLM_ANALYZER_MODEL=gemini-3.5-flash-lite
LLM_ANALYZER_FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_QUESTIONS_MODEL=claude-sonnet-4-6

# Certificate store (Upstash Redis via Vercel Marketplace). Leave empty for in-memory dev mode.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public base URL used inside certificates and QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo switches
NEXT_PUBLIC_DEFAULT_PACK=insurance-ulip-in
NEXT_PUBLIC_JUDGE_SOLO_MODE=true
